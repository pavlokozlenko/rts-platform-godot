# Godot 4+ specific ignores
.godot/
/android/

# Environment and secret files
.env
.env.*
!.env.example

# Credentials and local configuration
credentials.json
secrets.json
*.credentials
*.secret

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# SSH private keys
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
id_dsa
id_dsa.*
